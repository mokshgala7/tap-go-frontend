# ============================================================
# Tap&Go — .gitignore
# Covers: Python/FastAPI backend + React/Vite frontend
# ============================================================


# ──────────────────────────────────────────────────────────
# SECRETS & ENVIRONMENT — NEVER commit these
# ──────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
# Keep .env.example (it's the safe template)
!.env.example
# Allow frontend/.env — only contains non-secret Vercel build config (VITE_ vars)
!frontend/.env


# ──────────────────────────────────────────────────────────
# PYTHON / BACKEND
# ──────────────────────────────────────────────────────────

# Virtual environments
venv/
.venv/
env/
.env/
backend/venv/
backend/.venv/

# Python compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python package build
*.egg
*.egg-info/
dist/
build/
.eggs/
wheels/

# Type checker caches
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
coverage.xml
nosetests.xml
test-results/

# Jupyter
.ipynb_checkpoints/
*.ipynb


# ──────────────────────────────────────────────────────────
# NODE / FRONTEND
# ──────────────────────────────────────────────────────────

# Dependencies
node_modules/
frontend/node_modules/

# Build output (generated by npm run build)
dist/
frontend/dist/
build/

# Vite cache
.vite/
frontend/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ──────────────────────────────────────────────────────────
# USER UPLOADS (runtime data, not source code)
# ──────────────────────────────────────────────────────────
backend/uploads/
uploads/

# Keep the folder structure so the app can still create subdirs
!backend/uploads/.gitkeep


# ──────────────────────────────────────────────────────────
# macOS
# ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
Thumbs.db


# ──────────────────────────────────────────────────────────
# EDITORS / IDEs
# ──────────────────────────────────────────────────────────

# VS Code (keep shared extensions/settings if desired — remove if not)
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Vim / Emacs
*.swp
*.swo
*~
\#*\#


# ──────────────────────────────────────────────────────────
# MISC
# ──────────────────────────────────────────────────────────

# OS temp files
*.tmp
*.temp
*.bak
*.orig

# Logs
*.log
logs/
