# ============================================================
# Tap&Go Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, add these via the Vercel dashboard
# under Project Settings → Environment Variables.

# Backend API base URL (no trailing slash)
# Local:    http://localhost:8000
# Railway:  https://your-backend.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# PayU Integration Review Mode
# Set to "true" to show Demo Accounts on Login + PayU Info Card on Wallet
# Set to "false" (or leave empty) to hide both
VITE_PAYU_REVIEW_MODE=true
