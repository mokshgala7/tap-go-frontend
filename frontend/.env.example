# ============================================================
# Tap&Go Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, add these via the Vercel dashboard
# under Project Settings → Environment Variables.

# Backend API base URL (no trailing slash)
# Local:    http://localhost:8000
# Production: https://tap-go-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Demonstration & Testing Mode
# Set to "true" to show Demo Accounts on Login
# Set to "false" to hide demo helpers
VITE_DEMO_MODE=true
