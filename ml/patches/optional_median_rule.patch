+def median_rule_enabled() -> bool:
+    return os.getenv("TAPGO_FRAUD_MEDIAN_RULE", "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def median_rule_params():
+    """(multiplier, minimum earlier completed rides). Raises FraudConfigError for a malformed value."""
+    try:
+        mult = Decimal(os.getenv("TAPGO_FRAUD_MEDIAN_MULT", "2.0").strip() or "2.0")
+        minimum = int(os.getenv("TAPGO_FRAUD_MEDIAN_MIN_RIDES", "20").strip() or "20")
+    except (InvalidOperation, ValueError):
+        raise FraudConfigError("TAPGO_FRAUD_MEDIAN_MULT / TAPGO_FRAUD_MEDIAN_MIN_RIDES must be numbers (e.g. 2.0 and 20).")
+    if not mult.is_finite() or mult <= 0 or minimum < 1:
+        raise FraudConfigError("TAPGO_FRAUD_MEDIAN_MULT must be > 0 and TAPGO_FRAUD_MEDIAN_MIN_RIDES must be >= 1.")
+    return mult, minimum
+
+
+def median_rule(db, passenger_id: int, amount: Decimal, now: datetime) -> bool:
+    """True when `amount` >= K x the median of the passenger's own strictly earlier COMPLETED ride payments."""
+    mult, minimum = median_rule_params()
+    rows = (
+        db.query(Transaction.amount, Transaction.idempotency_key)
+        .filter(Transaction.passenger_id == passenger_id, Transaction.transaction_type == "ride_payment",
+                Transaction.status == "completed", Transaction.created_at.isnot(None), Transaction.created_at < now)
+        .all()
+    )
+    seen, amounts = set(), []
+    for amt, key in rows:
+        if amt is None or Decimal(str(amt)) <= 0 or (key is not None and key in seen):
+            continue
+        if key is not None:
+            seen.add(key)
+        amounts.append(Decimal(str(amt)))
+    if len(amounts) < minimum:
+        return False
+    amounts.sort()
+    n = len(amounts)
+    median = amounts[n // 2] if n % 2 else (amounts[n // 2 - 1] + amounts[n // 2]) / 2
+    return amount >= mult * median
+
+
